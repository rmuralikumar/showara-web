# Development Mode
# Set to false to enable live TMDB API fetching, or true for curated demo data
DEMO_MODE=false

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Payment Gateway Credentials (Test or Live)
# Get your API keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Persistent Database (PostgreSQL)
# Optional for local development (defaults to local SQLite in src/data/showara.db)
# Required for multi-instance production deployments
# DATABASE_URL="postgresql://user:password@localhost:5432/showara_db"

# Auth.js / NextAuth & Google OAuth Credentials
# Generate a secret using `openssl rand -base64 32` or any random string
AUTH_SECRET="your_auth_secret_here"
AUTH_URL="http://localhost:3000"

# Google OAuth Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your_google_oauth_client_id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your_google_oauth_client_secret"

